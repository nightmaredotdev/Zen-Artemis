[
  {
    "type": "separator",
    "label": "Appearance",
    "id": "artemis-section-appearance"
  },
  {
    "type": "dropdown",
    "property": "artemis.appearance.accent",
    "label": "Accent color",
    "description": "Follow Zen's accent color, or choose your own.",
    "defaultValue": "zen",
    "placeholder": false,
    "options": [
      {
        "value": "zen",
        "label": "Zen accent"
      },
      {
        "value": "custom",
        "label": "Custom"
      }
    ]
  },
  {
    "type": "string",
    "property": "artemis.appearance.accent-color",
    "label": "Custom accent",
    "description": "Any CSS color, e.g. #7c8aff or rgb(124 138 255).",
    "defaultValue": "#7c8aff",
    "placeholder": "#7c8aff",
    "pattern": "^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla|oklch|oklab|lch|lab)\\([0-9a-zA-Z.%,/ +-]{1,60}\\)|[a-zA-Z]{3,24})$",
    "conditions": [
      {
        "if": {
          "property": "artemis.appearance.accent",
          "value": "custom"
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.appearance.transparency",
    "label": "Surface transparency",
    "description": "How much shows through Artemis's glass surfaces. Solid makes them opaque.",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "value": "solid",
        "label": "Solid"
      },
      {
        "value": "low",
        "label": "Low"
      },
      {
        "value": "medium",
        "label": "Medium"
      },
      {
        "value": "high",
        "label": "High"
      },
      {
        "value": "custom",
        "label": "Custom"
      }
    ]
  },
  {
    "type": "string",
    "property": "artemis.appearance.transparency-custom",
    "label": "Custom surface opacity",
    "description": "Surface opacity as a percentage, e.g. 72%. Lower is more transparent.",
    "defaultValue": "72%",
    "placeholder": "72%",
    "pattern": "^(100|[1-9]?[0-9])(\\.[0-9]+)?%$",
    "conditions": [
      {
        "if": {
          "property": "artemis.appearance.transparency",
          "value": "custom"
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.appearance.blur",
    "label": "Glass blur",
    "description": "Blur strength behind Artemis's glass surfaces.",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "value": "none",
        "label": "None"
      },
      {
        "value": "light",
        "label": "Light"
      },
      {
        "value": "medium",
        "label": "Medium"
      },
      {
        "value": "strong",
        "label": "Strong"
      },
      {
        "value": "custom",
        "label": "Custom"
      }
    ]
  },
  {
    "type": "string",
    "property": "artemis.appearance.blur-custom",
    "label": "Custom blur",
    "description": "Blur radius in pixels, e.g. 18px.",
    "defaultValue": "18px",
    "placeholder": "18px",
    "pattern": "^([0-9]|[1-5][0-9]|6[0-4])(\\.[0-9]+)?px$",
    "conditions": [
      {
        "if": {
          "property": "artemis.appearance.blur",
          "value": "custom"
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.appearance.radius",
    "label": "Corner radius",
    "description": "One radius scale for every rounded Artemis element.",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "small",
        "label": "Small"
      },
      {
        "value": "medium",
        "label": "Medium"
      },
      {
        "value": "large",
        "label": "Large"
      },
      {
        "value": "custom",
        "label": "Custom"
      }
    ]
  },
  {
    "type": "string",
    "property": "artemis.appearance.radius-custom",
    "label": "Custom radius",
    "description": "Corner radius in pixels, e.g. 10px.",
    "defaultValue": "10px",
    "placeholder": "10px",
    "pattern": "^([0-9]|[1-2][0-9]|3[0-2])(\\.[0-9]+)?px$",
    "conditions": [
      {
        "if": {
          "property": "artemis.appearance.radius",
          "value": "custom"
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.appearance.spacing",
    "label": "Spacing",
    "description": "Padding and gaps inside Artemis-styled elements.",
    "defaultValue": "balanced",
    "placeholder": false,
    "options": [
      {
        "value": "tight",
        "label": "Tight"
      },
      {
        "value": "balanced",
        "label": "Balanced"
      },
      {
        "value": "relaxed",
        "label": "Relaxed"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Window",
    "id": "artemis-section-window"
  },
  {
    "type": "checkbox",
    "property": "artemis.window.frame",
    "label": "Artemis window frame",
    "description": "Artemis styling of the page frame. Off restores Zen's frame, including the options below.",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "artemis.window.edge-to-edge",
    "label": "Edge-to-edge page",
    "description": "Remove the gap and rounding around the page.",
    "defaultValue": "off",
    "placeholder": false,
    "options": [
      {
        "value": "off",
        "label": "Off"
      },
      {
        "value": "compact",
        "label": "Only in compact mode"
      },
      {
        "value": "always",
        "label": "Always"
      }
    ],
    "master": "artemis.window.frame"
  },
  {
    "type": "separator",
    "label": "Sidebar",
    "id": "artemis-section-sidebar"
  },
  {
    "type": "checkbox",
    "property": "artemis.sidebar.style",
    "label": "Artemis sidebar",
    "description": "Artemis styling of the sidebar, including the floating compact sidebar. Off restores Zen's sidebar, including the options below.",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "artemis.sidebar.hide-scrollbar",
    "label": "Hide sidebar scrollbar",
    "description": "Hide the scrollbar in the tab list. Scrolling still works.",
    "defaultValue": true,
    "master": "artemis.sidebar.style"
  },
  {
    "type": "separator",
    "label": "Tabs",
    "id": "artemis-section-tabs"
  },
  {
    "type": "checkbox",
    "property": "artemis.tabs.style",
    "label": "Artemis tabs",
    "description": "Artemis styling of tabs and folders. Off restores Zen's tabs, including the options below.",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "artemis.tabs.height",
    "label": "Tab height",
    "description": "Height of tabs in the tab list.",
    "defaultValue": "regular",
    "placeholder": false,
    "options": [
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "compact",
        "label": "Compact"
      },
      {
        "value": "regular",
        "label": "Regular"
      },
      {
        "value": "tall",
        "label": "Tall"
      }
    ],
    "master": "artemis.tabs.style"
  },
  {
    "type": "dropdown",
    "property": "artemis.tabs.shape",
    "label": "Tab shape",
    "description": "Corner shape of tabs. Rounded follows the corner radius setting.",
    "defaultValue": "rounded",
    "placeholder": false,
    "options": [
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "rounded",
        "label": "Rounded"
      },
      {
        "value": "square",
        "label": "Square"
      },
      {
        "value": "pill",
        "label": "Pill"
      }
    ],
    "master": "artemis.tabs.style"
  },
  {
    "type": "checkbox",
    "property": "artemis.tabs.active-highlight",
    "label": "Active tab highlight",
    "description": "A subtle accent tint and outline on the selected tab.",
    "defaultValue": true,
    "master": "artemis.tabs.style"
  },
  {
    "type": "checkbox",
    "property": "artemis.tabs.separators",
    "label": "Tab separators",
    "description": "Thin lines between tabs.",
    "defaultValue": false,
    "master": "artemis.tabs.style"
  },
  {
    "type": "checkbox",
    "property": "artemis.folders.indent-guide",
    "label": "Folder indent guide",
    "description": "A thin line marking the tabs inside an open folder.",
    "defaultValue": true,
    "master": "artemis.tabs.style"
  },
  {
    "type": "separator",
    "label": "Essentials",
    "id": "artemis-section-essentials"
  },
  {
    "type": "checkbox",
    "property": "artemis.essentials.style",
    "label": "Artemis essentials",
    "description": "Artemis tile styling for essential tabs. Zen's favicon background option is respected.",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Address bar",
    "id": "artemis-section-address-bar"
  },
  {
    "type": "checkbox",
    "property": "artemis.urlbar.style",
    "label": "Artemis address bar",
    "description": "Artemis styling of the address bar and its results panel. Off restores Zen's address bar, including the options below.",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "artemis.urlbar.dim-page",
    "label": "Dim page behind address bar",
    "description": "Subtly dim the page while the floating address bar is open.",
    "defaultValue": true,
    "master": "artemis.urlbar.style"
  },
  {
    "type": "separator",
    "label": "Toolbar",
    "id": "artemis-section-toolbar"
  },
  {
    "type": "checkbox",
    "property": "artemis.toolbar.style",
    "label": "Artemis toolbar buttons",
    "description": "Artemis radius and hover for toolbar and sidebar buttons. Off restores Zen's buttons, including the options below.",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "artemis.toolbar.logo-menu-button",
    "label": "Artemis logo menu button",
    "description": "Show the Artemis logo on the main menu button.",
    "defaultValue": true,
    "master": "artemis.toolbar.style"
  },
  {
    "type": "separator",
    "label": "Workspaces",
    "id": "artemis-section-workspaces"
  },
  {
    "type": "dropdown",
    "property": "artemis.workspaces.switcher",
    "label": "Workspace switcher",
    "description": "Minimal: monochrome icons with the active space highlighted. Dots: one dot per space, icons on hover.",
    "defaultValue": "minimal",
    "placeholder": false,
    "options": [
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "minimal",
        "label": "Minimal"
      },
      {
        "value": "dots",
        "label": "Dots"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Menus and popups",
    "id": "artemis-section-menus-and-popups"
  },
  {
    "type": "checkbox",
    "property": "artemis.popups.style",
    "label": "Artemis menus and panels",
    "description": "Artemis styling of menus, context menus and panels. Off restores Zen's popups, including the options below.",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "artemis.popups.findbar",
    "label": "Floating find bar",
    "description": "Show the find bar as a floating card over the page instead of a strip.",
    "defaultValue": true,
    "master": "artemis.popups.style"
  },
  {
    "type": "separator",
    "label": "Media",
    "id": "artemis-section-media"
  },
  {
    "type": "checkbox",
    "property": "artemis.media.controls",
    "label": "Artemis media controls",
    "description": "Artemis styling of the media controls card in the sidebar.",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Motion",
    "id": "artemis-section-motion"
  },
  {
    "type": "dropdown",
    "property": "artemis.motion.intensity",
    "label": "Animation intensity",
    "description": "Speed and travel of animations set to Artemis. Never turns animations on or off.",
    "defaultValue": "standard",
    "placeholder": false,
    "options": [
      {
        "value": "gentle",
        "label": "Gentle"
      },
      {
        "value": "standard",
        "label": "Standard"
      },
      {
        "value": "lively",
        "label": "Lively"
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.motion.hover",
    "label": "Hover feedback",
    "description": "Smooth highlight changes on tabs, buttons, results and workspace icons.",
    "defaultValue": "artemis",
    "placeholder": false,
    "options": [
      {
        "value": "artemis",
        "label": "Artemis"
      },
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "off",
        "label": "Off"
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "artemis.motion.popups",
    "label": "Menus and panels",
    "description": "How panels such as the main menu open. Plain context menus have no native animation on Windows.",
    "defaultValue": "artemis",
    "placeholder": false,
    "options": [
      {
        "value": "artemis",
        "label": "Artemis"
      },
      {
        "value": "zen",
        "label": "Zen default"
      },
      {
        "value": "off",
        "label": "Off"
      }
    ]
  }
]
